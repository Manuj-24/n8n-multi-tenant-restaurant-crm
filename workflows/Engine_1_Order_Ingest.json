        "operation": "executeQuery",
        "query": "INSERT INTO customers (\n  tenant_id,\n  phone,\n  email,\n  name,\n  total_orders,\n  total_spent,\n  last_order_at\n) VALUES (\n  '{{ $('Webhook: Order Ingest').first().json.body.tenant_id }}',\n  '{{ $('Webhook: Order Ingest').first().json.body.customer_phone }}',\n  '{{ $('Webhook: Order Ingest').first().json.body.customer_email }}',\n  '{{ $('Webhook: Order Ingest').first().json.body.customer_name }}',\n  1,\n  {{ $('Webhook: Order Ingest').first().json.body.order_total }},\n  NOW()\n)\nON CONFLICT (tenant_id,phone) \nDO UPDATE SET \n  total_orders = customers.total_orders + 1,\n  total_spent = customers.total_spent + EXCLUDED.total_spent,\n  last_order_at = NOW(),\n  name = EXCLUDED.name,\n  email = EXCLUDED.email\nRETURNING *;",
        "options": {}
