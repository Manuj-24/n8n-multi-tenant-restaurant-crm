    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  c.id AS customer_id,\n  c.tenant_id,\n  c.name AS customer_name,\n  c.phone AS customer_phone,\n  c.email AS customer_email,\n  c.segment,\n  c.last_order_at,\n  t.restaurant_name,\n  t.evolution_instance_name,\n  t.evolution_api_key,\n  t.sms_api_key,\n  CASE \n    WHEN c.last_order_at <= NOW() - INTERVAL '30 days' THEN 'WINBACK_30D'\n    WHEN c.last_order_at <= NOW() - INTERVAL '14 days' THEN 'REENGAGE_14D'\n    ELSE 'ACTIVE'\n  END AS campaign_type\nFROM customers c\nJOIN tenants t ON c.tenant_id = t.id\nWHERE t.is_active = TRUE\n  AND c.last_order_at <= NOW() - INTERVAL '14 days'\n  AND NOT EXISTS (\n    SELECT 1 \n    FROM campaign_logs l\n    WHERE l.customer_id = c.id\n      AND l.tenant_id = c.tenant_id\n      AND l.created_at >= NOW() - INTERVAL '14 days'\n      AND l.status IN ('SENT', 'SUCCESS')\n  )\nLIMIT 50;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "id": "84ef8008-ed7b-4895-854e-a2288df89a75",
      "name": "DB: Query Dormant Customers",
